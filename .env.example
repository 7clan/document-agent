# Choose gemini, openai, groq, ollama_cloud, or compatible. Ollama Gemma is the UI default.
# Groq hosts GPT-OSS, Qwen, and Llama models via an OpenAI-compatible API.
LLM_PROVIDER=ollama_cloud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Groq (pip install -e ".[openai,dev]"); the UI discovers account-accessible models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Ollama direct cloud API; select a cloud model verified to support tool calls.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com/v1
# For OpenRouter Gemma 4 (verified live), choose LLM_PROVIDER=compatible
# and enter your own OpenRouter key under COMPATIBLE_API_KEY. Never commit a real value.
# COMPATIBLE_MODEL=google/gemma-4-31b-it
# COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# Other Chat Completions-compatible hosts are also supported if their tools work.
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
# Local SQLite file (ignored by Git).
DOCUMENT_AGENT_DB_PATH=.local/document_index.db
# Maximum file size before warning and skip (MiB), configurable.
DOCUMENT_AGENT_MAX_FILE_MB=100

# Retrieval: keyword baseline; opt in to hybrid after installing embeddings.
DOCUMENT_AGENT_RETRIEVAL_MODE=keyword
DOCUMENT_AGENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave blank or pin a Hugging Face model revision for reproducibility.
DOCUMENT_AGENT_EMBEDDING_REVISION=
# Default is offline/private: model files must already be cached.
# Temporarily set 1 to explicitly download the local model on first use.
DOCUMENT_AGENT_EMBEDDING_ALLOW_DOWNLOAD=0
